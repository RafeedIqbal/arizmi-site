# Arizmi Site — environment variables
# Copy to .env for local development (`cp example.env .env`) and set the same
# values in Vercel → Project → Settings → Environment Variables for deploys.
# Unconfigured features fail closed: booking CTAs render disabled, the
# BluePrint flow uses a dev mock/memory store locally, and production refuses
# to run without the real provider + storage configured.

# ── Email (required — contact form + BluePrint delivery) ────────────────────
# Gmail account used as the SMTP identity for ALL outbound email.
# App password: Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional recipient overrides (both default to mish@icontraining.app).
CONTACT_RECIPIENT=
BLUEPRINT_LEAD_RECIPIENT=

# ── Booking CTA (required for live booking buttons) ─────────────────────────
# BOOKING_URL wins; NEXT_PUBLIC_CALENDLY_LINK is the legacy fallback.
# When both are empty, booking CTAs render a disabled "Link coming soon" state.
BOOKING_URL=
NEXT_PUBLIC_CALENDLY_LINK=

# ── Privacy policy (optional) ────────────────────────────────────────────────
# The site ships an internal /privacy page (draft copy — see docs/PRODUCTION.md).
# Set this only to override it with an externally hosted policy URL.
PRIVACY_POLICY_URL=

# ── BluePrint AI generation (required in production) ─────────────────────────
# "gemini" enables the real provider; leave unset in dev for the deterministic
# mock (the mock refuses to run in production).
BLUEPRINT_AI_PROVIDER=gemini
# Google AI Studio → Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional model override; defaults to gemini-2.5-flash.
BLUEPRINT_AI_MODEL=

# ── Lead storage (required in production) ────────────────────────────────────
# "upstash" enables durable Redis persistence; leave unset in dev for the
# in-memory store (which refuses to run in production).
LEAD_STORAGE=upstash
# From the Upstash console or the Vercel Marketplace integration. The KV_*
# names some Vercel integrations inject (KV_REST_API_URL / KV_REST_API_TOKEN)
# are accepted as fallbacks. Redis also backs the shared rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google Sheets lead mirror (optional, best-effort) ────────────────────────
# Service-account JSON key → client_email / private_key. Share the target
# spreadsheet with the client email (Editor). A Sheets failure never blocks a
# lead — Redis and the internal email remain authoritative.
GOOGLE_SHEETS_CLIENT_EMAIL=
# Keep the quotes; literal \n sequences in the PEM are handled automatically.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long id in the spreadsheet URL between /d/ and /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=

# NODE_ENV and VERCEL are set automatically by Next.js/Vercel — never set them
# manually.
